# Copy to .env and fill in. Every key below is free-tier friendly.
# The pipeline reads keys case-insensitively (see src/research/config.py).

# --- Retrieval (search + scrape) ---------------------------------------------
# Firecrawl: primary search + scrape -> Markdown. Free tier ~1,000 credits.
# Get one at https://firecrawl.dev/app/api-keys
firecrawl_api=

# Tavily: corroboration search channel. Free "Researcher" tier, no card.
# https://app.tavily.com
Tavily_api=

# Exa: second corroboration channel, strong at finding vendor-domain docs.
# https://dashboard.exa.ai/api-keys
Exa_api=

# --- LLMs --------------------------------------------------------------------
# Extractor: Anthropic. Forced tool_use gives constrained-JSON output.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Critic: a DIFFERENT vendor on purpose, so it does not share the extractor's
# priors (CLAUDE.md §4). Default provider is OpenAI; set CRITIC_PROVIDER=google
# to use Gemini instead (then set GEMINI_API_KEY).
CRITIC_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Composio ----------------------------------------------------------------
# Used for the authenticated catalog pull and the MCP "proof" artifact.
# If absent/invalid, catalog.py falls back to scraping composio.dev/toolkits.
# https://app.composio.dev/developers
Composio_api=

# --- Model pins (override to reproduce an exact run) -------------------------
EXTRACT_MODEL=claude-sonnet-5
CRITIC_MODEL=gpt-4.1
